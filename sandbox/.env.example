# Copiar a .env y ajustar.
# Ruta ABSOLUTA de esta carpeta en el HOST (la usan los bind-mounts de los forks).
# Si usas ./odoolab.ps1 o ./odoolab.sh se inyecta sola y podes dejarla vacia.
ODOLAB_HOST_ROOT=

COMPOSE_PROJECT_NAME=odolab
SANDBOX_NET=odolab-net

# Postgres compartido por el sandbox (una sola instancia, varias DBs)
PG_IMAGE=postgres:15
PG_USER=odoo
PG_PASSWORD=odoo
PG_DB_PROD=prod

# Produccion: NUNCA se migra, solo se clona.
PROD_ODOO_VERSION=16.0
PROD_HTTP_PORT=8069

# Fork: puerto base; cada run usa PORT_BASE + offset
FORK_PORT_BASE=8100

# Ruta (en el host) al codigo de TU herramienta de migracion.
# Se monta en /opt/tool dentro del contenedor fork.
MIGRATION_TOOL_PATH=../tool

# Cache de repos OCA/OpenUpgrade (volumen nombrado)
OCA_CACHE_VOLUME=odolab-oca-cache
